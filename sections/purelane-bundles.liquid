{% comment %}
  Purelane Bundles Comparison Tiers Section
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}

<section class="purelane-wrapper sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {% if section.settings.kicker != blank %}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {% endif %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'One box. Every room.' }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subheading | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' }}</p>
      </div>
    </div>

    <div class="tiers">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <article class="glass tier {% if block.settings.is_popular %}best{% endif %} rv" {{ block.shopify_attributes }}>
            <span class="tag">{{ block.settings.tag_label | default: 'Starter' }}</span>

            <div class="tierpix {% if block.settings.product_count >= 5 %}five{% endif %}" aria-hidden="true">
              <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
              <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
              {% if block.settings.product_count >= 3 %}
                <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
              {% endif %}
              {% if block.settings.product_count >= 5 %}
                <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
                <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
              {% endif %}
            </div>

            <div class="qty">{{ block.settings.product_count }}<small>Products</small></div>

            <div class="price">
              {{ block.settings.price }}
              {% if block.settings.compare_price != blank %}
                <s>{{ block.settings.compare_price }}</s>
              {% endif %}
            </div>

            {% if block.settings.per_product_note != blank %}
              <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>
            {% endif %}

            <ul>
              {% if block.settings.feature_1 != blank %}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.feature_1 }}
                </li>
              {% endif %}
              {% if block.settings.feature_2 != blank %}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.feature_2 }}
                </li>
              {% endif %}
              {% if block.settings.feature_3 != blank %}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.feature_3 }}
                </li>
              {% endif %}
            </ul>

            <a class="btn {% if block.settings.is_popular %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#shop' }}">
              {{ block.settings.cta_text | default: 'Build this box' }}
              {% if block.settings.is_popular %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              {% endif %}
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.tiers { display: grid; gap: 14px; grid-template-columns: 1fr; }
@media(min-width: 760px) { .tiers { grid-template-columns: repeat(3, 1fr); } }
.tier { padding: 24px 22px; transition: .4s var(--ease); display: flex; flex-direction: column; }
.tier:hover { transform: translateY(-5px); }
.tier.best { border-color: rgba(240, 160, 60, .44); box-shadow: 0 26px 74px rgba(18, 12, 34, .44), 0 0 0 1px rgba(240, 160, 60, .2), var(--g-inset); }
.tier .tag { display: inline-block; font-size: 9.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; margin-bottom: 14px; background: rgba(240, 160, 60, .18); border: 1px solid rgba(240, 160, 60, .34); color: var(--accent); align-self: flex-start; }
.tier .qty { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 52px; line-height: .9; color: var(--surface); letter-spacing: -.03em; }
.tier .qty small { font-size: 14px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-3); display: block; margin-top: 6px; }
.tier .price { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 27px; color: var(--accent); margin: 16px 0 4px; }
.tier .price s { font-size: 14px; color: var(--paper-3); font-weight: 500; margin-left: 8px; }
.tier ul { list-style: none; margin: 16px 0 20px; display: grid; gap: 8px; flex: 1; }
.tier li { display: flex; gap: 9px; font-size: 13px; color: var(--paper-2); }
.tier li svg { width: 14px; height: 14px; color: var(--accent); flex: 0 0 auto; margin-top: 4px; }
.tier .btn { width: 100%; justify-content: center; }

.tierpix { display: flex; align-items: flex-end; justify-content: center; gap: 2px; height: 78px; margin: -4px 0 16px; padding: 8px 6px; border-radius: 14px; background: linear-gradient(162deg, rgba(236, 230, 247, .10), rgba(75, 58, 143, .12)); border: 1px solid rgba(236, 230, 247, .12); }
.tierpix .pimg { height: 62px; filter: drop-shadow(0 8px 12px rgba(1, 24, 22, .5)); }
.tierpix.five .pimg { height: 54px; }
</style>

{% schema %}
{
  "name": "Purelane Bundles Tiers",
  "tag": "section",
  "class": "section-purelane-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Most Popular",
          "default": false
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tag Label",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Number of Products",
          "default": 2
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_note",
          "label": "Per Product Calculation Note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature Line 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature Line 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature Line 3"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles Tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_label": "Starter",
            "product_count": 2,
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_popular": true,
            "tag_label": "Most popular",
            "product_count": 3,
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_label": "Whole home",
            "product_count": 5,
            "price": "₹799",
            "compare_price": "₹1495",
            "per_product_note": "Flat ₹160 per product",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
