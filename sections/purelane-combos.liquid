{% comment %}
  Purelane Best-Selling Combos Rail Section
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}

<section class="purelane-wrapper sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Best selling combos' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' }}</p>
    </div>

    <div class="comborail rv">
      {% for block in section.blocks %}
        {% if block.type == 'combo' %}
          <article class="glass combo {% if block.settings.is_hero_combo %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {% if block.settings.savings_text != blank %}
                <span class="save">{{ block.settings.savings_text }}</span>
              {% endif %}
              {% if block.settings.flag_text != blank %}
                <span class="flag">{{ block.settings.flag_text }}</span>
              {% endif %}

              <div class="stack">
                <span class="it">
                  <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
                  <span>{{ block.settings.item_1_note | default: 'Cuts grease' }}</span>
                </span>
                <span class="plus" aria-hidden="true">+</span>
                <span class="it">
                  <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
                  <span>{{ block.settings.item_2_note | default: 'Squeaky clean' }}</span>
                </span>
                <span class="plus" aria-hidden="true">+</span>
                <span class="it">
                  <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
                  <span>{{ block.settings.item_3_note | default: 'Melts stains' }}</span>
                </span>
              </div>
            </div>

            <div class="body">
              <h3>{{ block.settings.title }}</h3>
              <div class="cnt">{{ block.settings.item_count_label | default: '3 products' }}</div>
              <p class="inc">{{ block.settings.description }}</p>
              
              <div class="prow">
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>
                {% endif %}
                {% if block.settings.savings_tag != blank %}
                  <em>{{ block.settings.savings_tag }}</em>
                {% endif %}
              </div>

              <div class="fine">{{ block.settings.fine_print | default: 'Inclusive of all taxes · COD available' }}</div>
              
              <a class="btn {% if block.settings.is_hero_combo %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#bundles' }}">
                {{ block.settings.cta_text | default: 'Shop bundle' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
      Swipe for more combos
    </div>
    <p class="railnote">{{ section.settings.rail_note | default: 'Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.' }}</p>
  </div>
</section>

<style>
.comborail { display: flex; gap: 14px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; margin: 0 -18px; padding: 4px 18px 14px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.comborail::-webkit-scrollbar { display: none; }
.combo { flex: 0 0 302px; scroll-snap-align: start; display: flex; flex-direction: column; padding: 0; transition: .4s var(--ease); }
.combo:hover { transform: translateY(-5px); }
.combo.hero-combo { border-color: rgba(240, 160, 60, .42); box-shadow: 0 26px 74px rgba(18, 12, 34, .44), 0 0 0 1px rgba(240, 160, 60, .2), var(--g-inset); }
.combo .tray { padding: 14px 14px 13px; border-bottom: 1px solid rgba(236, 230, 247, .13); position: relative; background: linear-gradient(162deg, rgba(236, 230, 247, .13), rgba(75, 58, 143, .10)); }
.combo .save { display: inline-block; font-size: 9.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; background: rgba(3, 30, 28, .72); border: 1px solid rgba(240, 160, 60, .34); color: var(--accent); margin-bottom: 13px; }
.combo .flag { position: absolute; top: 14px; right: 14px; font-size: 8.6px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; background: linear-gradient(135deg, var(--accent-2), #5d8d1c); color: #08211a; }
.stack { display: flex; align-items: flex-end; gap: 3px; }
.stack .it { flex: 1 1 0; min-width: 0; text-align: center; }
.stack .it .pimg { height: 66px; margin: 0 auto 8px; filter: drop-shadow(0 8px 13px rgba(1, 24, 22, .5)); }
.stack .it .tile { height: 66px; width: 44px; margin: 0 auto 8px; display: grid; place-items: center; border-radius: 9px; background: rgba(236, 230, 247, .08); border: 1px dashed rgba(236, 230, 247, .26); color: var(--accent); }
.stack .it .tile svg { width: 17px; height: 17px; }
.stack .it span { display: block; font-size: 8.6px; line-height: 1.32; color: var(--paper-2); font-weight: 600; }
.stack .plus { flex: 0 0 9px; color: var(--accent); font-weight: 800; font-size: 12px; padding-bottom: 30px; text-align: center; }
.combo .body { padding: 15px 16px 18px; display: flex; flex-direction: column; flex: 1; }
.combo .body h3 { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: -.005em; line-height: 1.1; color: var(--surface); }
.combo .cnt { font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--paper-3); margin-top: 6px; }
.combo .inc { font-size: 12.4px; color: var(--paper-2); line-height: 1.55; margin: 11px 0 14px; flex: 1; }
.combo .prow { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 6px; }
.combo .prow strong { font-family: 'Outfit', sans-serif; font-size: 25px; font-weight: 800; color: var(--surface); letter-spacing: -.02em; }
.combo .prow s { font-size: 13px; color: var(--paper-3); }
.combo .prow em { font-style: normal; font-size: 9.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; background: rgba(240, 160, 60, .18); border: 1px solid rgba(240, 160, 60, .36); color: var(--accent); }
.combo .fine { font-size: 10.4px; color: var(--paper-3); margin-bottom: 14px; }
.combo .btn { width: 100%; justify-content: center; }
.railnote { text-align: center; font-size: 12px; color: var(--paper-3); margin-top: 14px; max-width: 62ch; margin-left: auto; margin-right: auto; }
.swipecue { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--paper-3); margin-top: 2px; }
.swipecue svg { width: 14px; height: 14px; color: var(--accent); }

@media(max-width: 760px) {
  .combo { flex: 0 0 268px; }
  .stack .it .pimg { height: 56px; }
  .comborail { margin: 0 -14px; padding: 4px 14px 12px; }
}
</style>

{% schema %}
{
  "name": "Purelane Best Combos",
  "tag": "section",
  "class": "section-purelane-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Rail Note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Box",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_hero_combo",
          "label": "Highlight as Best Value Combo",
          "default": false
        },
        {
