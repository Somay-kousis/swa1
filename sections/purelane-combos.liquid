          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen."
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Top Savings Badge",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Right Corner Flag",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare At Price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "savings_tag",
          "label": "Savings Tag",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine Print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link"
        },
        {
          "type": "text",
          "id": "item_1_note",
          "label": "Item 1 Note",
          "default": "Cuts grease"
        },
        {
          "type": "text",
          "id": "item_2_note",
          "label": "Item 2 Note",
          "default": "Squeaky clean"
        },
        {
          "type": "text",
          "id": "item_3_note",
          "label": "Item 3 Note",
          "default": "Melts stains"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Best Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen essentials",
            "savings_text": "You save ₹398",
            "flag_text": "Most popular",
            "price": "₹499",
            "compare_price": "₹897",
            "savings_tag": "Save ₹398"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Laundry care bundle",
            "savings_text": "You save ₹448",
            "price": "₹499",
            "compare_price": "₹947",
