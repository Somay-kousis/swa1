{% comment %}
  Purelane Reviews Auto-Marquee Rail Section
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}

<section class="purelane-wrapper sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      <span class="agg">
        <span class="st">★★★★★</span>
        <b>{{ section.settings.rating_score | default: '4.8' }}</b>
        {{ section.settings.rating_text | default: 'from 8,000+ reviews' }}
      </span>
      {% if section.settings.social_proof_text != blank %}
        <span class="agg">Loved by <b>{{ section.settings.social_proof_text }}</b></span>
      {% endif %}
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% comment %} First Loop of Blocks {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">★★★★★</div>
            <h5>{{ block.settings.heading }}</h5>
            <p>{{ block.settings.review_text }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author_name }}</b>
              {% if block.settings.product_purchased != blank %}
                <span>· {{ block.settings.product_purchased }}</span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}

      {% comment %} Duplicate Loop for Infinite Continuous Marquee Animation {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="glass-2 rcard" aria-hidden="true">
            <div class="st">★★★★★</div>
            <h5>{{ block.settings.heading }}</h5>
            <p>{{ block.settings.review_text }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author_name }}</b>
              {% if block.settings.product_purchased != blank %}
                <span>· {{ block.settings.product_purchased }}</span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.revband { padding: var(--sec-y) 0; }
.revhead { display: flex; align-items: center; justify-content: center; gap: 10px 18px; flex-wrap: wrap; margin-bottom: 14px; }
.revhead .agg { display: inline-flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--paper-2); }
.revhead .agg b { font-family: 'Outfit', sans-serif; font-size: 16px; color: var(--accent); letter-spacing: 0; }
.revhead .st { color: var(--accent); font-size: 12px; letter-spacing: .16em; }

.revrail { overflow: hidden; position: relative; -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
.revtrack { display: flex; gap: 12px; width: max-content; animation: marq 52s linear infinite; }
.revrail:hover .revtrack, .revrail:focus-within .revtrack { animation-play-state: paused; }
@keyframes marq { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }

.rcard { flex: 0 0 auto; width: 284px; padding: 15px 17px; border-radius: 18px; }
.rcard .st { color: var(--accent); font-size: 10.5px; letter-spacing: .2em; margin-bottom: 9px; }
.rcard h5 { font-family: 'Outfit', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--surface); margin-bottom: 7px; }
.rcard p { font-size: 12.6px; color: var(--paper-2); line-height: 1.52; margin-bottom: 11px; }
.rcard .who { display: flex; align-items: center; gap: 7px; font-size: 9.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--paper-3); }
.rcard .who b { color: var(--surface); font-weight: 700; }
.rcard .who svg { width: 12px; height: 12px; color: var(--accent); flex: 0 0 auto; }

@media(max-width: 760px) {
  .rcard { width: 250px; padding: 13px 14px; }
  .revtrack { animation-duration: 40s; }
}
@media (prefers-reduced-motion: reduce) {
  .revtrack { animation: none !important; }
}
</style>

{% schema %}
{
  "name": "Purelane Reviews Marquee",
  "tag": "section",
  "class": "section-purelane-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Label",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Social Proof Callout",
      "default": "12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Review Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Body",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_purchased",
          "label": "Product Purchased",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Marquee",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "heading": "Works like a charm",
            "review_text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author_name": "Anita",
            "product_purchased": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Best dishwash ever",
            "review_text": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author_name": "Priya",
            "product_purchased": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Great product, great packaging",
            "review_text": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author_name": "Sunita",
            "product_purchased": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Dog friendly",
            "review_text": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author_name": "Rohit S.",
            "product_purchased": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Sparkling taps again",
            "review_text": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author_name": "Verified buyer",
            "product_purchased": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
